# Use this when running WITHOUT Docker (npm run dev directly)
# Run: cp .env.local .env  before starting locally

PORT=3000
NODE_ENV=development

JWT_SECRET=medicare_ai_jwt_secret_changeme_in_production_2024
JWT_REFRESH_SECRET=medicare_ai_refresh_secret_changeme_in_production_2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Local PostgreSQL (install separately or use Docker just for DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_db
DB_USER=hospital_user
DB_PASSWORD=hospital_pass
DB_SSL=false

# Gemini AI - GET FROM https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_key_here

# Email (optional - OTPs print to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Set to true to skip OTP for testing
SKIP_OTP=true
